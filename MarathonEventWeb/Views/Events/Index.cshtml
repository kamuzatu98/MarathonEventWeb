@model IEnumerable<MarathonEventWeb.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-4">
    <h2>Marathon Events</h2>

    <p class="mt-3">
        <a asp-action="Create" class="btn btn-primary">Create New Event</a>
    </p>

    <table class="table table-striped table-bordered mt-2">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Description</th>
                <th>Location</th>
                <th>Distance</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.EventName)</td>
                    <td>@Html.DisplayFor(modelItem => item.EventDescription)</td>
                    <td>@Html.DisplayFor(modelItem => item.EventLocation)</td>
                    <td>@Html.DisplayFor(modelItem => item.Distance)</td>
                    <td>@Html.DisplayFor(modelItem => item.EventType)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>